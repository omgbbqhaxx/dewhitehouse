# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.

# WalletConnect Project ID — https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base mainnet için tercih edilen RPC (boş bırakılırsa herkese açık RPC kullanılır)
NEXT_PUBLIC_BASE_RPC=

# Deploy edilmiş DeWhiteHouse kontrat adresi (Base)
NEXT_PUBLIC_CONTRACT_ADDR=0x0000000000000000000000000000000000000000
